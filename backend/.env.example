# This file is a template. Supply values via your server's environment manager.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Production profile: MySQL/MariaDB, Redis 인증 저장소, HTTPS 쿠키.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://127.0.0.1:3306/gyuhwan?connectionTimeZone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=gyuhwan
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 32바이트 이상의 무작위 키를 Base64로 인코딩한 값을 별도 환경 관리자로 공급한다.
JWT_SECRET=
COOKIE_SECURE=true
BIND_ADDRESS=127.0.0.1
PORT=8080

# Generate the values with: node deploy/generate-secrets.mjs --compose-env
# Copy generated .env only to the deployment host. No real secrets are committed here.
# 아래 HTTP/루프백 기본값은 로컬 확인용이다. 공개 배포에서는 COOKIE_SECURE=true와 HTTPS 진입점을 사용한다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DB_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_TTL_SECONDS=1800
COOKIE_SECURE=false
# 같은 호스트 Tunnel의 접속 주소를 확인할 때만 true로 바꾸고 확인 후 false로 되돌린다.
ACCESS_LOG_ENABLED=false
# Cloudflare Tunnel override 전에 앱이 실제로 본 프록시 주소만 일치하도록 설정한다.
# TRUSTED_PROXY_REGEX=172\.20\.0\.1
PUBLIC_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_IMAGE=gyuhwan-admin:local
